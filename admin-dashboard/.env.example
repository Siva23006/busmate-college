# Copy to .env.local
# Backend URL (the Node.js API). Use your laptop LAN IP if opening the dashboard from another device.
NEXT_PUBLIC_API_URL=http://localhost:4000

# Google Maps JavaScript API key. Restrict it to your domains (HTTP referrers) in Google Cloud Console.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
# Optional: a Map ID from Google Cloud (Map Management). Leave empty to use the default style.
NEXT_PUBLIC_GOOGLE_MAP_ID=
