# ---- Copy this file to .env and fill it in. Never commit .env ----
NODE_ENV=development
PORT=4000

# Neon: Dashboard -> your project -> Connect -> copy the connection string (pooled is fine)
# Example shape: postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=
DATABASE_SSL=true

# Long random string (at least 32 chars). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Browser origins allowed to call the API (admin dashboard). Comma separated.
CORS_ORIGINS=http://localhost:3000

# ---- Tracking / ETA tuning (defaults are fine to start) ----
GPS_POOR_ACCURACY_M=100
ETA_DEFAULT_SPEED_KMH=25
ETA_STOP_DWELL_SECONDS=30
BUS_OFFLINE_AFTER_SECONDS=60
OVERSPEED_KMH=60
ROUTE_DEVIATION_M=300
APPROACHING_MINUTES=5

# ---- Push notifications (Phase 13, optional) ----
# Firebase console -> Project settings -> Service accounts -> Generate new private key.
# Save the JSON OUTSIDE git (e.g. backend/secrets/firebase.json) and put its path here.
FIREBASE_SERVICE_ACCOUNT_PATH=

# ---- Road routing (optional) ----
# Routes follow real roads using OSRM. The public server (default) is for light / demo
# use only; for production host your own OSRM and put its URL here.
# OSRM_URL=https://router.project-osrm.org

# ---- DEMO / SIMULATION (development only; keep false in production) ----
ALLOW_SIMULATION=true

# Time zone used for "today" and schedule delays on the admin Track Bus page.
APP_TIME_ZONE=Asia/Kolkata
